{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soatvan.local/contracts/model-manifest.schema.json",
  "title": "SoatVan model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "version", "engine_protocol", "file", "size", "sha256", "license_file", "trust", "capabilities"],
  "properties": {
    "schema_version": {"const": 2},
    "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "version": {"type": "string", "minLength": 1},
    "engine_protocol": {"type": "integer", "minimum": 1},
    "file": {"type": "string", "pattern": "^[^/\\\\]+$"},
    "size": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "license_file": {"type": "string", "pattern": "^[^/\\\\]+$"},
    "memory_mb": {"type": "integer", "minimum": 1},
    "context_size": {"type": "integer", "minimum": 512, "maximum": 32768},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 64},
    "max_tokens": {"type": "integer", "minimum": 32, "maximum": 4096},
    "review_chunk_tokens": {"type": "integer", "minimum": 64, "maximum": 32768},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 180},
    "seed": {"type": "integer"},
    "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "trust": {"enum": ["release_signed", "local_unverified"]},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_filter", "full_review"],
      "properties": {
        "candidate_filter": {"const": true},
        "full_review": {"type": "boolean"}
      }
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_sha256", "profiles"],
      "properties": {
        "corpus_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "profiles": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["machine_memory_mb", "documents", "precision", "recall", "p95_seconds", "peak_rss_mb", "report_sha256"],
            "properties": {
              "machine_memory_mb": {"type": "number", "minimum": 7000},
              "documents": {"type": "integer", "minimum": 20},
              "precision": {"type": "number", "minimum": 0.9, "maximum": 1},
              "recall": {"type": "number", "minimum": 0.85, "maximum": 1},
              "p95_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
              "peak_rss_mb": {"type": "number", "exclusiveMinimum": 0},
              "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "signature": {"type": "string", "minLength": 32}
  },
  "allOf": [
    {
      "if": {"properties": {"trust": {"const": "release_signed"}}},
      "then": {"required": ["quality_gate", "signature"]}
    },
    {
      "if": {"properties": {"trust": {"const": "local_unverified"}}},
      "then": {
        "properties": {
          "capabilities": {
            "properties": {"full_review": {"const": false}}
          }
        },
        "not": {
          "anyOf": [
            {"required": ["quality_gate"]},
            {"required": ["signature"]}
          ]
        }
      }
    }
  ]
}
