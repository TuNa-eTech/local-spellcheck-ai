{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soatvan.local/contracts/benchmark-ground-truth.schema.json",
  "title": "SoatVan benchmark ground truth",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "provenance", "documents"],
  "properties": {
    "schema_version": {"const": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "provenance": {"enum": ["draft", "human_reviewed", "synthetic_example"]},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/document"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "source_sha256", "annotations"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "annotations": {
          "type": "array",
          "items": {"$ref": "#/$defs/annotation"}
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "disposition",
        "category",
        "block_id",
        "start",
        "end",
        "source_text"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["required", "optional", "must_not_warn"]},
        "category": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "block_id": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "source_text": {"type": "string", "minLength": 1},
        "accepted_suggestions": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string"}
            }
          ]
        },
        "note": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"enum": ["required", "optional"]}}},
          "then": {"required": ["accepted_suggestions"]}
        },
        {
          "if": {"properties": {"disposition": {"const": "must_not_warn"}}},
          "then": {"not": {"required": ["accepted_suggestions"]}}
        }
      ]
    }
  }
}
