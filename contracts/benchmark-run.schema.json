{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soatvan.local/contracts/benchmark-run.schema.json",
  "title": "SoatVan benchmark run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "corpus_id",
    "configuration",
    "performance",
    "quality",
    "documents"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "corpus_id": {"type": "string", "minLength": 1},
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_id", "model_id", "model_version", "quantization"],
      "properties": {
        "prompt_id": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "quantization": {"type": "string", "minLength": 1}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_seconds", "peak_rss_mb"],
      "properties": {
        "latency_seconds": {"type": "number", "minimum": 0},
        "peak_rss_mb": {"type": "number", "minimum": 0}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "coverage_percent",
        "timeout_chunks",
        "invalid_output_chunks",
        "truncated_outputs"
      ],
      "properties": {
        "status": {"enum": ["complete", "partial", "failed"]},
        "coverage_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "timeout_chunks": {"type": "integer", "minimum": 0},
        "invalid_output_chunks": {"type": "integer", "minimum": 0},
        "truncated_outputs": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Null when the runtime only exposes the combined invalid_output_chunks metric."
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "source_sha256", "findings"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "findings": {
            "type": "array",
            "items": {
              "allOf": [
                {"$ref": "https://soatvan.local/contracts/finding.schema.json"},
                {"required": ["confidence"]}
              ]
            }
          }
        }
      }
    }
  }
}
