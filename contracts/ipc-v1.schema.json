{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soatvan.local/contracts/ipc-v1.schema.json",
  "title": "SoatVan NDJSON frame v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "method", "params"],
      "properties": {
        "v": {"const": 1},
        "id": {"type": "string", "minLength": 1},
        "method": {"enum": ["engine.hello", "document.inspect", "job.start", "job.cancel", "custom_rule.list", "custom_rule.upsert", "custom_rule.delete", "model.status", "model.import", "model.cancel", "model.remove", "ai_config.get", "ai_config.update", "ai_config.set_active", "ai_config.test_connection"]},
        "params": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "job.start"}}},
          "then": {
            "properties": {
              "params": {
                "properties": {
                  "use_model": {"type": "boolean"},
                  "full_review": {"type": "boolean", "default": false},
                  "include_rule_findings": {"type": "boolean", "default": false}
                },
                "allOf": [
                  {
                    "if": {
                      "required": ["include_rule_findings"],
                      "properties": {"include_rule_findings": {"const": true}}
                    },
                    "then": {
                      "required": ["use_model", "full_review"],
                      "properties": {
                        "use_model": {"const": true},
                        "full_review": {"const": true}
                      }
                    }
                  },
                  {
                    "if": {
                      "required": ["full_review"],
                      "properties": {"full_review": {"const": true}}
                    },
                    "then": {
                      "required": ["use_model"],
                      "properties": {"use_model": {"const": true}}
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "ok"],
      "properties": {
        "v": {"const": 1}, "id": {"type": "string"}, "ok": {"type": "boolean"},
        "result": {},
        "error": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}, "additionalProperties": false}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "event", "data"],
      "properties": {
        "v": {"const": 1},
        "event": {"enum": ["job.progress", "job.completed", "job.no_findings", "job.failed"]},
        "data": {"type": "object"}
      }
    }
  ]
}
